texts = Dictionary[StringName, String]({
&"crit_failure": "荧晶已到手。",
&"crit_success": "荧晶根部还生着一小丛磷伞菇——药铺常年收这个，又添一笔。",
&"failure": "荧晶已到手。",
&"success": "跟到岔道深处，鬼火停在一片干燥的岩壁上——是矿脉上附生的荧晶群在幽幽发光。撬下几块，就是实打实的钱。"
})

