[sub_resource type="Resource" id="Resource_m7s56"]
script = ExtResource("3_j1xlw")
reward = SubResource("Resource_ccyl6")
unlock_flag = &"secret_door_mine_north"
texts = Dictionary[StringName, String]({
&"crit_failure": "松动的砖块哗啦啦砸了一地。你们后跳半步，灰头土脸——墙里似乎有什么翻动了一下，又归于寂静。",
&"crit_success": "窄道口的墙角塞着一个油布小包——干硬的口粮，和十五枚旧币。先行者留下的，现在归你们了。",
&"failure": "敲遍了整面北墙，声音都闷闷的。也许……真的只是风。",
&"success": "北壁的砖缝确实透着风。抠开几块松动的砖，一条仅容一人侧身的窄道露了出来——绕过整段塌陷区，直通矿洞深处。前人早就在砖上刻了记号。"
})
comment = "E3-14：成功侧 failure/crit_failure 为不可达防御位（此路无失败）——文案对齐失败侧；crit 修饰文案单源 crit_success 档（E3 双载体定论）"

[resource]
script = ExtResource("4_8s7fd")
id = &"sp_mine_secretdoor"
display_name = "北壁的风"
narrative_text = "矿洞一层的北壁。凑近了听——砖缝里确实透着一丝极轻的风声，若有若无。"
check_attr_id = &"perception"
difficulty_tier = "极难"
