[resource]
script = ExtResource("1_7d0pl")
id = &"sp_village_traveler"
display_name = "井边的旅人"
narrative_text = "水井边坐着个斗篷旅人，脚边斜靠着一柄裹布的长枪。见你们过来，他举了举锡杯：「下矿的？听一句劝——这矿里的墙，不都是实心的。北边那面，敲一敲。」说完他把杯子扣在井沿上，走了。"
success_outcome = SubResource("Resource_e3hgy")
comment = "【占位·试玩校准】案 18 §2.4 无检定单档结算（暗门铺垫）"
