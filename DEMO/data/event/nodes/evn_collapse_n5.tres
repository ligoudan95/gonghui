[resource]
script = ExtResource("3_3sdk8")
id = &"evn_collapse_n5"
display_name = "支护稳救"
chain_id = &"chain_mine_collapse"
narrative_text = "找来坑木、垫上石楔，支护、清石、再支护——多花了一整天，稳稳当当把人请了出来。老周千恩万谢，就着火把画了张他记得的旧矿道草图，末了指了指北边：「那一带的墙，敲起来有空响，你们留心。」"
outcome = SubResource("Resource_wsyl3")
comment = "【占位·试玩校准】案 18 §2.1 n5 终端（o3 纯选择·耗时 +1 天）；E12：纯选择去向无检定档——crit 档死键已清（原存钱点文案不可达）"
