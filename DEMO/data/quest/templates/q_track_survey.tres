[resource]
script = ExtResource("2_qtd")
id = &"q_track_survey"
display_name = "轨道勘验"
goal_type = 1
goal_param = &"tp_mine_track_yard"
region_id = &"reg_mine"
map_id = &"map_m1_village_mine"
party_min = 2
party_max = 4
time_limit_days = 5
reward = SubResource("Resource_rwd")
abandonable = true
expire_behavior = 2
recommend_attrs = Array[StringName]([&"agility", &"intelligence"])
issuer = "光辉城商会"
description = "运矿的轨道荒了太久，枕木朽没朽、道钉松没松，商会要一份准话。走到调车场尽头看一眼。"
comment = "【占位·试玩校准】案 18 §2.6 定稿行 8：explore→tp_mine_track_yard；2-4 人/5 天/替换；建议按 3-4 人编队出征；公共字段=案 18 §2.6（普通/战斗/档 1/全矿洞/150金·80经验·声望5/超额 0=走 cfg 0.15）"
