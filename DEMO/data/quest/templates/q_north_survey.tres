recommend_attrs = Array[StringName]([&"perception", &"intelligence"])
issuer = "协会"
description = "不止一个人说，北边那面墙后有风。去看，去听，去记——别只顾着敲。"
comment = "【占位·试玩校准】案 18 §2.6 定稿行 5：explore→tp_mine_north_wall；2-4 人/5 天/替换；建议按 3-4 人编队出征；公共字段=案 18 §2.6（普通/战斗/档 1/全矿洞/150金·80经验·声望5/超额 0=走 cfg 0.15）"
