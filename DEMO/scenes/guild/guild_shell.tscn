[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/scene_flow/guild_shell.gd" id="1_guild"]

[node name="GuildShell" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_guild")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.11, 0.09, 1)

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 12.0
offset_right = -16.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="TopBar" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="DayLabel" type="Label" parent="Layout/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "第 1 天·周一"

[node name="GoldLabel" type="Label" parent="Layout/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "0 金"

[node name="ReputationLabel" type="Label" parent="Layout/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "声望 0"

[node name="TopSpacer" type="Control" parent="Layout/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="BackButton" type="Button" parent="Layout/TopBar"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(160, 48)
focus_mode = 2
text = "返回标题"

[node name="MainBox" type="HBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
