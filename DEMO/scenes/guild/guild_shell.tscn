[node name="HeaderLabel" type="Label" parent="Center/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "公会主场景（占位）"
horizontal_alignment = 1

[node name="SaveInfoLabel" type="Label" parent="Center/Layout"]
unique_name_in_owner = true
